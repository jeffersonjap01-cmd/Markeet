flowchart TB
  %% Markeet Firebase NoSQL Architecture
  %% Source of truth: current Swift codebase and Firestore collection usage.

  subgraph AUTH["Firebase Authentication"]
    Auth["FirebaseAuth<br/>Email/password registration<br/>Email/password login<br/>Password reset<br/>Email verification<br/>Apple credential sign-in<br/>Auth state listener"]
  end

  subgraph STORAGE["Firebase Storage"]
    ProfileImages["profileImages/{uid}/profile.jpg<br/>Used by StorageService.uploadProfileImage"]
  end

  subgraph FIRESTORE["Cloud Firestore"]
    Users["users/{uid}<br/>uid: String<br/>fullName: String<br/>email: String<br/>role: String<br/>profileImageURL: String?<br/>bio: String<br/>createdAt: Timestamp<br/>onboardingStartDate: Timestamp<br/>onboardingEndDate: Timestamp<br/>onboardingActive: Bool<br/>marketingInterests: [String]<br/>assignedCommunities: [String]<br/>savedMaterials: [String]<br/>registeredEvents: [String]<br/>bannedStatus: Bool<br/>fcmToken: String?"]

    Groups["groups/{groupId}<br/>groupId: String<br/>groupName: String<br/>description: String<br/>batchNumber: Int<br/>startDate: Timestamp<br/>endDate: Timestamp<br/>registrationOpen: Bool<br/>status: String<br/>tag: String<br/>tags: [String]<br/>members: [uid]<br/>mentors: [uid]<br/>maxMembers: Int<br/>minMembers: Int<br/>maxMentors: Int<br/>minMentors: Int<br/>createdAt: Timestamp"]

    Chats["chats/{groupId}<br/>participants: [uid] expected by rules<br/>Document id matches groupId in ChatService"]
    Messages["chats/{groupId}/messages/{messageId}<br/>messageId: String<br/>senderId: String<br/>senderName: String<br/>content: String<br/>createdAt: Timestamp<br/>deleted: Bool"]

    Posts["posts/{postId}<br/>postId: String<br/>authorId: String<br/>content: String<br/>imageURL: String?<br/>likeCount: Int<br/>commentCount: Int<br/>reportCount: Int<br/>createdAt: Timestamp<br/>deleted: Bool"]

    PostComments["post_comments/{commentId}<br/>commentId: String<br/>postId: String<br/>userId: String<br/>userName: String<br/>content: String<br/>likeCount: Int<br/>createdAt: Timestamp<br/>deleted: Bool"]

    PostLikes["post_likes/{postId_userId}<br/>likeId: String<br/>postId: String<br/>userId: String<br/>createdAt: Timestamp"]

    PostCommentLikes["post_comment_likes/{commentId_userId}<br/>likeId: String<br/>commentId: String<br/>userId: String<br/>createdAt: Timestamp"]

    Reports["reports/{postId_userId}<br/>reportId: String<br/>reporterId: String<br/>targetId: String<br/>targetType: String<br/>reason: String<br/>status: String<br/>createdAt: Timestamp<br/>updatedAt: Timestamp?"]

    News["news/{newsId}<br/>newsId: String<br/>title: String<br/>description: String<br/>imageURL: String?<br/>createdAt: Timestamp<br/>createdBy: String<br/>category: String"]

    Materials["materials/{materialId}<br/>materialId: String<br/>title: String<br/>description: String<br/>thumbnailURL: String?<br/>contentURL: String<br/>createdAt: Timestamp<br/>createdBy: String<br/>tags: [String]"]

    Activities["activities/{activityId}<br/>activityId: String<br/>title: String<br/>description: String<br/>date: Timestamp<br/>startTime: Timestamp<br/>endTime: Timestamp<br/>mentorId: String<br/>assignedUserIds: [uid]<br/>createdAt: Timestamp<br/>updatedAt: Timestamp"]

    ActivityAssignments["activity_assignments/{activityId_userId}<br/>assignmentId: String<br/>activityId: String<br/>userId: String<br/>mentorId: String<br/>completed: Bool<br/>completedAt: Timestamp?<br/>assignedAt: Timestamp"]

    Events["events/{eventId}<br/>eventId: String<br/>title: String<br/>description: String<br/>imageURL: String?<br/>location: String<br/>startDate: Timestamp<br/>endDate: Timestamp<br/>capacity: Int<br/>registrationDeadline: Timestamp<br/>mentorId: String<br/>participantCount: Int<br/>createdAt: Timestamp<br/>updatedAt: Timestamp"]

    EventRegistrations["event_registrations/{eventId_userId}<br/>registrationId: String<br/>eventId: String<br/>userId: String<br/>mentorId: String<br/>registeredAt: Timestamp"]
  end

  subgraph SERVICES["Application Firebase Services"]
    AuthService["AuthService"]
    UserService["UserService"]
    AdminBootstrapService["AdminBootstrapService"]
    GroupService["GroupService"]
    ChatService["ChatService"]
    PostService["PostService"]
    CommentService["CommentService"]
    LikeService["LikeService"]
    CommentLikeService["CommentLikeService"]
    ReportService["ReportService"]
    NewsService["NewsService"]
    MaterialService["MaterialService"]
    ScheduleService["ScheduleService"]
    StorageService["StorageService"]
    SessionManager["SessionManager"]
  end

  Auth --> AuthService
  Auth --> SessionManager
  AuthService --> Users
  SessionManager --> Users
  AdminBootstrapService --> Users
  UserService --> Users
  StorageService --> ProfileImages
  Users --> ProfileImages

  GroupService --> Groups
  GroupService --> Users
  Groups -- "members[] / mentors[]" --> Users
  Users -- "assignedCommunities[]" --> Groups

  ChatService --> Messages
  Groups -- "groupId used as chatId" --> Chats
  Chats --> Messages
  Messages -- "senderId" --> Users

  PostService --> Posts
  Posts -- "authorId" --> Users
  CommentService --> PostComments
  PostComments -- "postId" --> Posts
  PostComments -- "userId" --> Users
  LikeService --> PostLikes
  PostLikes -- "postId" --> Posts
  PostLikes -- "userId" --> Users
  CommentLikeService --> PostCommentLikes
  PostCommentLikes -- "commentId" --> PostComments
  PostCommentLikes -- "userId" --> Users
  PostComments -- "increments commentCount" --> Posts
  PostLikes -- "increments likeCount" --> Posts
  PostCommentLikes -- "increments likeCount" --> PostComments

  PostService --> Reports
  ReportService --> Reports
  ReportService --> Posts
  ReportService --> Users
  Reports -- "reporterId" --> Users
  Reports -- "targetId when targetType=post" --> Posts
  Reports -- "updates reportCount/status" --> Posts

  NewsService --> News
  News -- "createdBy" --> Users
  MaterialService --> Materials
  Materials -- "createdBy" --> Users
  Users -- "savedMaterials[]" --> Materials

  ScheduleService --> Activities
  ScheduleService --> ActivityAssignments
  ScheduleService --> Events
  ScheduleService --> EventRegistrations
  ScheduleService --> Users
  ScheduleService --> Groups
  Activities -- "mentorId" --> Users
  Activities -- "assignedUserIds[]" --> Users
  ActivityAssignments -- "activityId" --> Activities
  ActivityAssignments -- "userId" --> Users
  ActivityAssignments -- "mentorId" --> Users
  Events -- "mentorId" --> Users
  EventRegistrations -- "eventId" --> Events
  EventRegistrations -- "userId" --> Users
  EventRegistrations -- "mentorId" --> Users
  EventRegistrations -- "increments participantCount" --> Events
  Users -- "registeredEvents[]" --> Events

  Materials -. "thumbnailURL/contentURL are stored URLs; upload service is not implemented for materials" .-> STORAGE
